# مُعرِّفات القياس — تُضبط في Vercel (Settings ← Environment Variables)
# الموقع يعمل كاملًا بدونها؛ طبقة القياس تصمت حين لا يوجد مُعرِّف.

# Google Analytics 4 — من admin ← Data Streams
VITE_GA_ID=G-XXXXXXXXXX

# Meta Pixel — من Events Manager، أرقام فقط
VITE_META_PIXEL_ID=

# Google Ads — Tools ← Conversions. المعرّف AW-… والتسمية هي ما بعد «/» في send_to
VITE_GADS_ID=
# الشراء (صفحة الشكر، 2000 SAR) — التحويل الأساسي
VITE_GADS_PURCHASE_LABEL=
VITE_GADS_WHATSAPP_LABEL=
VITE_GADS_PDF_LABEL=

# الدفع عبر Ziina (دالة /api/pay) — بلا VITE_: تبقى على الخادم ولا تصل المتصفح
# المفتاح من https://ziina.com/business/connect بصلاحية write_payment_intents
ZIINA_API_KEY=
# 1 = عمليات تجريبية بلا خصم (أي بطاقة). احذفه للتشغيل الفعلي
ZIINA_TEST=1
# كلمة سرّ أداة روابط الدفع (/pay-link) — طويلة وعشوائية، يعرفها صاحب الحساب وحده
PAY_LINK_PASSWORD=

# 1 = القياس يعمل خارج daamah.net — للاختبار المحلي وحده، لا يُضبط في Vercel
# VITE_ANALYTICS_ANY_HOST=1

# Google Search Console — طريقة «وسم HTML»، قيمة content وحدها
VITE_GSC_VERIFICATION=

# ── برنامج شركاء التأسيس (/founding-partners) ──
# قاعدة البيانات: Vercel ← Storage ← Upstash for Redis — تُضاف وحدها عند الربط
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# كلمة سرّ لوحة البرنامج (/founding-partners/admin) — بدونها تُستخدم PAY_LINK_PASSWORD
FP_ADMIN_PASSWORD=
# سرّ توقيع أحداث Ziina (/api/ziina-hook) — نصّ عشوائي طويل، ثم «ربط Ziina webhook» من اللوحة
# المفتاح يحتاج صلاحية write_webhooks
ZIINA_WEBHOOK_SECRET=
# Meta Conversions API — Events Manager ← Settings ← Conversions API ← Generate access token
META_CAPI_TOKEN=
# META_PIXEL_ID=          (وإلا VITE_META_PIXEL_ID)
# META_TEST_EVENT_CODE=   (للتجربة من «Test events» — يُحذف بعدها)
# n8n — رابط عقدة Webhook، وسرّ يُرسل في X-Daamah-Secret
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
