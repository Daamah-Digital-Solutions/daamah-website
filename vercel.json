{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/national-day",
      "destination": "/launch",
      "statusCode": 301
    },
    {
      "source": "/website-offer",
      "destination": "/launch",
      "statusCode": 301
    },
    {
      "source": "/our-portfolio",
      "destination": "/work",
      "statusCode": 301
    },
    {
      "source": "/our-portfolio/:path+",
      "destination": "/work",
      "statusCode": 301
    },
    {
      "source": "/partners",
      "destination": "/work",
      "statusCode": 301
    },
    {
      "source": "/services/marketing-solutions",
      "destination": "/services/digital-marketing",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "daamah-website.vercel.app"
        }
      ],
      "destination": "https://daamah.net/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.daamah.net"
        }
      ],
      "destination": "https://daamah.net/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".+\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
